PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nearvo
# Set DATABASE_SSL=true for hosted Postgres that requires SSL
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Frontend URL (used for CORS and for links in emails). Comma-separate several.
CLIENT_URL=http://localhost:5173

# Where uploaded profile photos are stored
UPLOAD_DIR=./uploads

# ABN Lookup web services GUID (free from https://abr.business.gov.au/Tools/WebServices).
# Keep it secret: it is only used on the server. Without it, ABNs/ACNs are only checksum-validated.
ABR_GUID=

# Where reports / complaints are emailed, and the admin login created by `npm run db:setup -- --no-demo`
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# Email (leave SMTP_HOST empty to print emails to the console during development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nearvo <no-reply@nearvo.app>
